{# ============================================
   HEADER TEMPLATE - Site header with logo and navigation
   ============================================ #}
<header class="">
    {# Container for header content #}
    <div class="container flex justify-between align-center">
        {# Logo - Links to homepage #}
        <div class="logo">
            <a href="/">
                <img class="logo__img" src="/assets/media/Jo-smith-photography-logo.png" alt="Jo's Photography Home">
            </a>
        </div>

        {# Primary Navigation - Generated from Eleventy navigation plugin #}
        <nav id="primary-nav" class="primary-nav">
            {# Auto-generated navigation menu from page front matter #}
            {{ collections.all | eleventyNavigation | eleventyNavigationToHtml | safe }}

            {# Hamburger Menu Button - Mobile navigation toggle #}
            <button id="nav-btn" class="primary-nav__btn">
                <span class="nav-btn__bar"></span>
                <span class="nav-btn__bar"></span>
                <span class="nav-btn__bar"></span>
        </button>
        </nav>
    </div>
</header>