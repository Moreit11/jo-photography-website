{# ============================================
   HEAD TEMPLATE - Document metadata and resources
   ============================================ #}
<head>
    {# Character encoding - UTF-8 for international character support #}
    <meta charset="UTF-8">

    {# Viewport - Responsive design viewport configuration #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Page Title - Uses meta_title if available, otherwise page title + site name #}
    <title>{% if meta_title %} {{ meta_title}} {% else %} {{title}} | {{site.name}} {% endif %} </title>

    {# Meta Description - Standard search snippet tag #}
    <meta name="description" content="{% if meta_description %}{{ meta_description }}{% else %}Jo Smith Photography — professional photographer based in Dundee, Scotland. Wedding, couple and engagement photography across Tayside and the Scottish Highlands.{% endif %}">

    <!-- Open Graph Tags - Social media sharing metadata -->
    <meta property="og:title" content="Jo's Photography">
    <meta property="og:description" content="{% if meta_title %} {{ meta_description }} {% else %} {{ site.description }} {% endif %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://josphotography.com/">
    <meta property="og:image" content="https://josphotography/og-image.jpg">

    <!-- Google Fonts - preconnect then load async to avoid render blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"></noscript>

    <!-- Splide CSS - loaded async as the slider is below the fold -->
    <link rel="preload" as="style" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css"></noscript>

    <!-- Hero image - preload dynamically from front matter so browser fetches before parsing body -->
    {% if heroImage %}
    <link rel="preload" as="image" href="{{ heroImage }}" fetchpriority="high">
    {% endif %}

    <!-- Main Stylesheet - Custom styles and Tailwind CSS -->
    <link rel="stylesheet" href="/assets/tailwind/tailwind.css">
</head>