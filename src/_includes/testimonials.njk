{# ============================================
   TESTIMONIALS SECTION - Client reviews carousel
   ============================================ #}
<section class="testimonials">
  <div class="container">
    {# Section Header - Title and subtitle #}
    <div class="testimonials__header">
      <h2 class="testimonials__title">{% if testimonialTitle %}{{ testimonialTitle }}{% else %} "What Clients Say" {% endif %}</h2>
      <p class="testimonials__subtitle">{% if testimonialText %}{{ testimonialText | safe }}{% else %}Hear from those who have experienced my photography{% endif %}</p>
    </div>
    {# Splide Carousel Container - Testimonial slider #}
    <div class="splide testimonials__carousel" id="testimonials-carousel">
      <div class="splide__track">
        <ul class="splide__list">
          {# Loop through testimonials from data file #}
          {%- for testimonial in testimonials.testimonials -%}
          <li class="splide__slide">
            {# Individual Testimonial Card #}
            <div class="testimonial-card">
              {# Star Rating - Generate stars based on rating number #}
              <div class="testimonial-card__stars">
                {% for star in range(0, testimonial.rating) %}
                <svg class="star-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                {% endfor %}
              </div>
              {# Testimonial Quote #}
              <blockquote class="testimonial-card__quote">
                <p>"{{ testimonial.text }}"</p>
              </blockquote>
              {# Author Information #}
              <div class="testimonial-card__author">
                <div class="testimonial-card__info">
                  <cite class="testimonial-card__name">{{ testimonial.name }}</cite>
                  <span class="testimonial-card__location">{{ testimonial.location }}</span>
                </div>
              </div>
            </div>
          </li>
          {%- endfor -%}
        </ul>
      </div>
      {# Pagination Dots - Auto-generated by Splide #}
      <ul class="splide__pagination"></ul>
    </div>
  </div>
</section>
